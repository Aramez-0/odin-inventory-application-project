<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pokemon</title>
  </head>
  <body>
    <%- include('header')%>
    <h3>Pokemon</h3>
    <% if (pokemon) { %>
    <ul>
      <% pokemon.forEach((pokemon) => { %>
      <li><%= pokemon.name%>, <%= pokemon.type %></li>
      <% }) %>
    </ul>
    <% } %>
    <form action="/pokemon/delete" method="post">
      <label for="name">Input pokemon name to delete</label>
      <input type="text" name="name" id="name" required />
      <button onclick="return confirmDeletion()">Submit</button>
    </form>
    <script>
      function confirmDeletion() {
        const superSecretPassword = "Tacos!";
        const answer = prompt(`Please enter password to delete item`);
        if (answer != superSecretPassword) return false;
        else return true;
      }
    </script>
  </body>
</html>
