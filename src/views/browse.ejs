<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Browse</title>
  </head>
  <body>
    <%- include('header')%>
    <h3>Browse</h3>
    <h4>Filters</h4>
    <label for="pokemon">Pokemon: </label>
    <input type="checkbox" name="pokemon" id="pokemon" />
    <label for="type">Type: </label>
    <select name="type" id="type">
      <option value="none">None</option>
      <option value="normal">Normal</option>
      <option value="fire">Fire</option>
      <option value="water">Water</option>
      <option value="grass">Grass</option>
      <option value="flying">Flying</option>
      <option value="fighting">Fighting</option>
      <option value="poison">Poison</option>
      <option value="electric">Electric</option>
      <option value="ground">Ground</option>
      <option value="rock">Rock</option>
      <option value="psychic">Psychic</option>
      <option value="ice">Ice</option>
      <option value="bug">Bug</option>
      <option value="ghost">Ghost</option>
      <option value="steel">Steel</option>
      <option value="dragon">Dragon</option>
      <option value="dark">Dark</option>
      <option value="fairy">Fairy</option>
    </select>
    <label for="trainers">Trainers: </label>
    <input type="checkbox" name="trainers" id="trainers" />
    <% if (pokemon) { %>
      <h5>Pokemon</h5>
    <ul>
      <% pokemon.forEach((pokemon) => { %>
      <li><%= pokemon.name%>, <%= pokemon.type %></li>
      <% }) %>
    </ul>
    <% } %> <% if (trainers) { %>
      <h5>Trainers</h5>
    <ul>
      <% trainers.forEach((trainer) => { %>
      <li>
        <h5><%= trainer.name %></h5>
        <%= trainer.pokemon1 %>, <%= trainer.pokemon2 %>, <%= trainer.pokemon3
        %>, <%= trainer.pokemon4 %>, <%= trainer.pokemon5 %>, <%=
        trainer.pokemon6 %>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </body>
</html>
